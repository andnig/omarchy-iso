#!/bin/bash

NO_MAKE=""
RC_RELEASE=""

while [[ $# -gt 0 ]]; do
  case $1 in
  --no-make)
    NO_MAKE=1
    shift
    ;;
  --rc)
    RC_RELEASE=1
    shift
    ;;
  -*)
    echo "Unknown option: $1"
    echo "Usage: omarchy-iso-release [--no-make] [--rc] [version]"
    exit 1
    ;;
  *)
    if [[ -n "${BUILD_VERSION-}" ]]; then
      echo "Usage: omarchy-iso-release [--no-make] [--rc] [version]"
      exit 1
    fi
    BUILD_VERSION="$1"
    shift
    ;;
  esac
done

if [[ -z "${BUILD_VERSION-}" ]]; then
  echo "Usage: omarchy-iso-release [--no-make] [--rc] [version]"
  exit 1
fi

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
BUILD_RELEASE_PATH="$BUILD_ROOT/release"

publish_iso() {
  local installer_ref=$1
  local release_suffix=$2
  local latest_iso
  local release_iso
  local iso_sha

  latest_iso=$(\ls -t "$BUILD_RELEASE_PATH"/*x86_64-"$installer_ref".iso | head -n1)
  release_iso="$BUILD_RELEASE_PATH/pondhouse-linux-$BUILD_VERSION$release_suffix.iso"
  cp "$latest_iso" "$release_iso"

  echo -e "\e[32mSigning $installer_ref ISO\e[0m"
  omarchy-iso-sign "$release_iso"

  iso_sha=$(sha256sum "$release_iso")
  echo -e "\e[32mSHA256 for $installer_ref ISO: $iso_sha\e[0m"

  omarchy-iso-upload "$release_iso"
}

if [[ -z $NO_MAKE ]]; then
  if [[ -n $RC_RELEASE ]]; then
    echo -e "\e[32mMaking rc ISO\e[0m"
    omarchy-iso-make --no-cache --no-boot-offer --rc
  else
    echo -e "\e[32mMaking master ISO\e[0m"
    omarchy-iso-make --no-cache --no-boot-offer

    echo -e "\e[32mMaking dev ISO\e[0m"
    omarchy-iso-make --no-cache --no-boot-offer --dev
  fi
else
  echo -e "\e[31mSkipping remaking ISOs\e[0m"
fi

if [[ -n $RC_RELEASE ]]; then
  publish_iso rc -rc
else
  publish_iso master ""
  publish_iso dev -dev
fi
