#!/bin/bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: omarchy-iso-sign [release/omarchy.iso]"
  exit 1
fi

iso="$1"

if [[ ! -f $iso ]]; then
  echo "ISO not found: $iso" >&2
  exit 1
fi

if ! pacman -Q gnupg >/dev/null 2>&1; then
  sudo pacman -S --noconfirm --needed --quiet gnupg
fi

signing_key="$(
  gpg --batch --with-colons --list-secret-keys |
    awk -F: '$1 == "fpr" { print $10; exit }'
)"

if [[ -z $signing_key ]]; then
  echo "No GPG secret key found. Create one with: gpg --full-generate-key" >&2
  exit 1
fi

gpg --batch --yes \
  --local-user "$signing_key" \
  --output "$iso.sig" \
  --detach-sig "$iso"
